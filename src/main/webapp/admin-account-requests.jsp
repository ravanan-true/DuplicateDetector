<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.sql.*,com.duplicatedetector.util.DBConnection" %>
<%!
private String esc(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
%>
<%
if(session.getAttribute("userId")==null || !"ADMIN".equals(session.getAttribute("userRole"))){response.sendRedirect(request.getContextPath()+"/login.jsp");return;}
String message=request.getParameter("message");
try(Connection c=DBConnection.getConnection();Statement st=c.createStatement()){st.executeUpdate("CREATE TABLE IF NOT EXISTS account_status_requests (request_id BIGINT PRIMARY KEY AUTO_INCREMENT, user_id INT NOT NULL, requested_status VARCHAR(20) NOT NULL, request_status VARCHAR(20) NOT NULL DEFAULT 'PENDING', requested_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, reviewed_at TIMESTAMP NULL, reviewed_by INT NULL, CONSTRAINT fk_account_request_user FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE)");}catch(SQLException e){application.log("Unable to initialize account request table",e);}
%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Account Requests | DuplicateDetector</title>
<style>*{box-sizing:border-box}body{margin:0;background:#080d1b;color:#f1f5f9;font-family:Arial,sans-serif}nav{padding:20px 5%;background:#10182b;border-bottom:1px solid #293853;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}nav a{color:#cbd5e1;text-decoration:none;margin-left:15px}.brand{font-weight:bold;color:#60a5fa;font-size:21px}main{max-width:1200px;margin:35px auto;padding:0 20px}.muted{color:#94a3b8}.notice{padding:12px;border-radius:8px;background:#153b30;color:#bbf7d0;margin:15px 0}.wrap{overflow:auto;border:1px solid #293853;border-radius:12px;background:#10182b}table{border-collapse:collapse;width:100%;min-width:760px}th,td{padding:14px;text-align:left;border-bottom:1px solid #293853}th{color:#93c5fd;background:#151f35}button{padding:9px 12px;border:0;border-radius:7px;color:white;cursor:pointer} .approve{background:#15803d}.reject{background:#9f1239}.pending{color:#fcd34d}footer{text-align:center;padding:25px;color:#64748b}</style></head><body>
<%@ include file="/navbar.jsp" %>
<main><h1>Account Status Requests</h1><p class="muted">Review user requests to activate or deactivate their accounts. Account status changes only when a request is approved.</p>
<% if(message!=null){ %><div class="notice"><%=esc(message.replace('+',' '))%></div><% } %>
<div class="wrap"><table><thead><tr><th>Request ID</th><th>User</th><th>Email</th><th>Requested Action</th><th>Status</th><th>Requested At</th><th>Review</th></tr></thead><tbody>
<% int count=0; String sql="SELECT r.request_id,r.requested_status,r.request_status,r.requested_at,u.full_name,u.email FROM account_status_requests r JOIN users u ON u.user_id=r.user_id ORDER BY CASE WHEN r.request_status='PENDING' THEN 0 ELSE 1 END,r.requested_at DESC";
try(Connection c=DBConnection.getConnection();Statement st=c.createStatement();ResultSet rs=st.executeQuery(sql)){while(rs.next()){count++;%>
<tr><td><%=rs.getLong("request_id")%></td><td><%=esc(rs.getString("full_name"))%></td><td><%=esc(rs.getString("email"))%></td><td><%=esc(rs.getString("requested_status"))%></td><td class="<%= "PENDING".equals(rs.getString("request_status"))?"pending":"" %>"><%=esc(rs.getString("request_status"))%></td><td><%=esc(String.valueOf(rs.getTimestamp("requested_at")))%></td><td>
<% if("PENDING".equals(rs.getString("request_status"))){ %><form method="post" action="<%=request.getContextPath()%>/account-request" style="display:inline" onsubmit="return confirm('Approve this account status request?');"><input type="hidden" name="action" value="review"><input type="hidden" name="requestId" value="<%=rs.getLong("request_id")%>"><input type="hidden" name="decision" value="APPROVE"><button class="approve">Approve</button></form> <form method="post" action="<%=request.getContextPath()%>/account-request" style="display:inline" onsubmit="return confirm('Reject this request?');"><input type="hidden" name="action" value="review"><input type="hidden" name="requestId" value="<%=rs.getLong("request_id")%>"><input type="hidden" name="decision" value="REJECT"><button class="reject">Reject</button></form><% } else { %>Reviewed<% } %></td></tr>
<% }}catch(SQLException e){application.log("Unable to load account requests",e);%><tr><td colspan="7">Unable to load requests. Ensure the database is available.</td></tr><% } if(count==0){%><tr><td colspan="7" style="text-align:center;padding:25px;color:#94a3b8">No account requests yet.</td></tr><%}%>
</tbody></table></div></main><footer>DuplicateDetector · Account Administration</footer></body></html>
